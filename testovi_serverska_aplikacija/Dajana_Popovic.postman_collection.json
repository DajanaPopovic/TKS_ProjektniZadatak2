  "item": [
    {
      "name": "Add Student",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Status code",
              "pm.test(\"Student created successfully (status 200)\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "// Response body exists",
              "pm.test(\"Response body is not empty\", function () {",
              "    pm.expect(pm.response.json()).to.not.be.empty;",
              "});",
              "",
              "// studentName exists",
              "pm.test(\"Response has studentName field\", function () {",
              "    pm.expect(pm.response.json()).to.have.property(\"studentName\");",
              "});",
              "",
              "//  studentName value is correct",
              "pm.test(\"Student name is Marko\", function () {",
              "    pm.expect(pm.response.json().studentName).to.eql(\"Marko\");",
              "});",
              "",
              "// studentEmail exists",
              "pm.test(\"Response has studentEmail field\", function () {",
              "    pm.expect(pm.response.json()).to.have.property(\"studentEmail\");",
              "});",
              "",
              "// studentEmail value is correct",
              "pm.test(\"Student email is correct\", function () {",
              "    pm.expect(pm.response.json().studentEmail).to.eql(\"marko@mail.com\");",
              "});",
              "",
              "//  studentBranch exists",
              "pm.test(\"Response has studentBranch field\", function () {",
              "    pm.expect(pm.response.json()).to.have.property(\"studentBranch\");",
              "});",
              "",
              "// studentBranch value is allowed",
              "pm.test(\"Student branch is valid\", function () {",
              "    pm.expect(pm.response.json().studentBranch).to.eql(\"BCA\");",
              "});",
              "",
              "",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
